# Copy to .env.local and fill in. VAPID_PRIVATE_KEY is a real secret; set it
# in the host's environment variables, never in a committed file.

# Enka.Network asks every client to send a reachable contact in its User-Agent
# so they can identify traffic and warn you if something is wrong. Set this to
# a repo URL, a site or an email before deploying anywhere public — the code
# falls back to "contact-not-set", which is honest but useless to them.
#
#   docs: https://github.com/EnkaNetwork/API-docs/blob/master/api.md
STARFALL_CONTACT=https://example.com/your-repo

# Web Push. Generate the pair once with `pnpm vapid` and keep it — changing the
# keys invalidates every subscription anyone has already made.
#
# The public key ships in the client bundle, which is what the browser needs to
# subscribe. The private key signs each push and must not.
#
#   RFC 8292: https://datatracker.ietf.org/doc/html/rfc8292
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Copy to .env.local and fill in. Nothing here is secret in v1.

# Enka.Network asks every client to send a reachable contact in its User-Agent
# so they can identify traffic and warn you if something is wrong. Set this to
# a repo URL, a site or an email before deploying anywhere public — the code
# falls back to "contact-not-set", which is honest but useless to them.
#
#   docs: https://github.com/EnkaNetwork/API-docs/blob/master/api.md
STARFALL_CONTACT=https://example.com/your-repo
